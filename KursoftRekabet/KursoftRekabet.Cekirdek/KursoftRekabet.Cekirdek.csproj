<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>KursoftRekabet</RootNamespace>
    <AssemblyName>KursoftRekabet.Cekirdek</AssemblyName>
    <Version>2.0.0</Version>
    <!-- Ayrıştırma (parse) sınıfları test projesinden de görülsün -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Kod stili: LINQ kullanılmıyor; derleyici de buna uysun -->
    <Using Remove="System.Linq" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KursoftRekabet.Test" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.65.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- HTML'i tarayıcısız (kayıtlı dosyadan) CSS seçiciyle okuyabilmek için -->
    <PackageReference Include="AngleSharp" Version="1.10.5" />
  </ItemGroup>

</Project>
