<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>KursoftRekabet.Gorev</RootNamespace>
    <AssemblyName>KursoftRekabet.Gorev</AssemblyName>
    <Version>2.0.0</Version>
    <!-- Zamanlanmış görevde konsol penceresi önemli değil; çıktı log dosyalarında -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kod stili: LINQ kullanılmıyor; derleyici de buna uysun -->
    <Using Remove="System.Linq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KursoftRekabet.Cekirdek\KursoftRekabet.Cekirdek.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <!-- Seçici ayarları çözüm kökünde tek dosya; exe yanına kopyalanır -->
    <None Include="..\secici-ayarlari.json" Link="secici-ayarlari.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
